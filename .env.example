# ChangeRadar server configuration. Copy to .env and replace every placeholder.
# Never commit a filled-in .env. Standalone mode with embedded PostgreSQL needs only the first two values.

# PostgreSQL 17 connection (production), or embedded PostgreSQL for evaluation and small installs:
#   pglite:/absolute/path/to/data-dir     (a directory, created with owner-only permissions)
#   pglite:memory                          (throwaway, for experiments)
CHANGERADAR_DATABASE_URL=postgres://changeradar:<db-password>@127.0.0.1:5432/changeradar
# Used by compose.yaml for the bundled database container.
POSTGRES_PASSWORD=<db-password>
# Optional literal password override for CHANGERADAR_DATABASE_URL (Compose supplies this automatically).
# CHANGERADAR_DATABASE_PASSWORD=<literal-password>

# Exactly 32 random bytes, base64. Seals stored credential values (AES-256-GCM) and keys CSRF and rate limit MACs.
# Keep it OUT of the database and OUT of backups; losing it makes sealed credential values unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHANGERADAR_ENCRYPTION_KEY=<base64-32-bytes>

# Bind address and port. 127.0.0.1 (the default) means "this machine only". 0.0.0.0 means every network
# interface: only use it behind a TLS reverse proxy or a firewall you control.
CHANGERADAR_HOST=127.0.0.1
CHANGERADAR_PORT=8797
# Public URL behind your TLS reverse proxy. Session cookies carry the Secure flag unless this starts with http://
# Leave it unset for a local try-out over http://localhost (Compose then uses http://localhost:8797); some browsers
# refuse a Secure cookie on plain http. Set it to your https address when you put a TLS proxy in front.
# CHANGERADAR_PUBLIC_URL=https://changeradar.example.invalid

# Egress allowlist for read-only contract checks and event delivery: comma separated host, host:port or *.suffix.
# Empty (the default) means the server never makes an outbound request. Private and loopback addresses are
# refused even for allowlisted names.
CHANGERADAR_CHECK_ALLOWED_HOSTS=
# TEST ONLY. Lets allowlisted hosts resolve to loopback and private ranges. Leave unset (or 0) in production.
# CHANGERADAR_CHECK_ALLOW_PRIVATE_NETWORK=0
# CHANGERADAR_CHECK_MAX_BODY_BYTES=1048576
# CHANGERADAR_CHECK_MAX_TIMEOUT_MS=30000

# Optional at-least-once delivery of outbox events (versioned envelope) to a URL on the allowlist. Off when unset.
# CHANGERADAR_EVENT_SINK_URL=https://sink.example.invalid/changeradar-events

# Limits (defaults shown). Lowering is allowed; raising the manifest limits above the PRD maximums is not.
# CHANGERADAR_MAX_MANIFEST_BYTES=26214400
# CHANGERADAR_MAX_NODES=10000
# CHANGERADAR_MAX_EDGES=50000
# The bundle limit is the largest file export writes and verify-bundle and restore accept (64 MiB). Restoring one takes
# about 40 times its size in memory for ordinary text (up to about 130 times for a bundle made of numbers or one-key
# objects): raise it only on a host with that much free.
# CHANGERADAR_MAX_BUNDLE_BYTES=67108864
# CHANGERADAR_RATE_LIMIT_PER_MINUTE=1200
# CHANGERADAR_SESSION_TTL_SECONDS=43200
# CHANGERADAR_JOB_LEASE_SECONDS=60
# Idempotency-Key retention in days (never below 7).
# CHANGERADAR_IDEMPOTENCY_RETENTION_DAYS=7

# Proposed retention defaults. They are REPORTED by GET /api/v1/settings and used as the default window of
# `changeradar retention`; nothing is ever deleted automatically. The operator must approve them before ingesting
# real data (see docs/OPERATIONS.md).
# CHANGERADAR_RETENTION_EVIDENCE_DAYS=90
# CHANGERADAR_RETENTION_DELETION_HOURS=24
# CHANGERADAR_RETENTION_BACKUP_DAYS=30

# Set to 1 for allowlisted request and worker diagnostics (cookies, authorization headers, bodies and query strings
# are never logged in any mode).
CHANGERADAR_LOG=0

# Directory with the built web UI. Normally unset: `serve` uses dist/web next to the compiled server.
# CHANGERADAR_WEB_ROOT=/absolute/path/to/dist/web
