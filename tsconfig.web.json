{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/report/wording.ts", "tests/web/**/*.tsx", "vite.config.ts", "vitest.web.config.ts"]
}
