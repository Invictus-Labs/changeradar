{
  "name": "changeradar",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted change-impact analysis: see which known consumers a proposed manifest change can break.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "changeradar": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/web",
    "migrations",
    "schemas",
    "fixtures",
    ".env.example",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/*.md",
    "docs/qa/*.md",
    "docs/prd/changeradar.md",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "prepack": "npm run build && node scripts/write-build-info.mjs",
    "build:server": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run && npm run test:web",
    "test:coverage": "vitest run --coverage && npm run test:web:coverage",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check",
    "bench": "tsx scripts/benchmark.ts",
    "licenses": "node scripts/dependency-licenses.mjs",
    "verify": "bash scripts/verify-quality.sh",
    "bench:api": "tsx scripts/benchmark-api.ts",
    "durability:pg17": "node scripts/durability-proof-pg17.mjs",
    "mutation": "node scripts/mutation-controls.mjs",
    "mutation:web": "node scripts/web-mutation-controls.mjs",
    "mutation:check": "node scripts/check-mutant-instruments.mjs",
    "start": "node dist/src/cli.js serve",
    "build:web": "vite build",
    "dev:web": "vite",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test:web:coverage": "vitest run -c vitest.web.config.ts --coverage",
    "e2e": "playwright test --project=browser",
    "e2e:packaged": "playwright test --project=packaged",
    "demo": "node dist/src/cli.js demo"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "ajv": "8.20.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
